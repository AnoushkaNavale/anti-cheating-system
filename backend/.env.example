PORT=3001
EXAM_FEE_ETH=0.01

# Pinata is used for IPFS uploads. No IPFS Desktop app is needed.
PINATA_API_KEY=your_pinata_api_key
PINATA_SECRET_KEY=your_pinata_secret_key

# Enable backend-side blockchain writes to Ganache Desktop.
GANACHE_URL=http://127.0.0.1:7545
CONTRACT_ADDRESS=your_deployed_examlogger_contract_address
PRIVATE_KEY=your_ganache_owner_account_private_key
